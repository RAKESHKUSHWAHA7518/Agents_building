# Copy this file to .env and fill in your values

# Required — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Required — JWT signing secret, at least 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Free trial: uploads allowed for anonymous users before signup is required
GUEST_FREE_UPLOADS=1

# MongoDB — Atlas cloud (mongodb+srv://...) or local (docker compose runs one)
# Default matches the local container in docker-compose.yml
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=pdf_chat
VECTOR_SEARCH_INDEX=vector_index

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Models
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Uploads
MAX_FILE_SIZE_MB=10

# Sessions
SESSION_TTL_MINUTES=30
MAX_HISTORY_MESSAGES=20

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
UPLOAD_RATE_LIMIT_MAX=10
